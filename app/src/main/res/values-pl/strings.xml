    <string name="about_title">O aplikacji</string>
    <string name="about_version">Wersja %1$s</string>
    <string name="about_description">Natywny klient Android dla LibreSign, aplikacji do podpisu elektronicznego dla Nextcloud. Nie przygotowuje dokumentów ani nie umieszcza pól podpisu - dzieje się to gdzie indziej. NextSign pokazuje, co czeka na Twój podpis, i podpisuje to jednym dotknięciem za pomocą metody click-to-sign LibreSign.</string>

