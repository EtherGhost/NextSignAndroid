    <!-- About - title/version/description translate normally, but the License and
         Disclaimer section (headers and body both) are deliberately kept English-only
         in every language - legal/attribution content, not general UI text. Matches
         the Ubuntu Touch app's own convention (see NextCommon/AboutPage.qml) of never
         translating this section. Do not add these keys to values-*/strings.xml. -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_description">A native Android client for LibreSign, the electronic signature app for Nextcloud. It does not prepare documents or place signature fields - that happens elsewhere. NextSign shows what is waiting for your signature and signs it with a tap using LibreSign\'s click-to-sign method.</string>
