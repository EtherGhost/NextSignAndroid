<?xml version="1.0" encoding="utf-8"?>
<!-- Inverted from the Ubuntu Touch app's assets/logo.svg: white lines/signature stroke
     directly on the blue background (ic_launcher_background), no separate white card.
     This isn't just a color swap for its own sake - it also structurally avoids the
     adaptive-icon masking gap the card-based version had: the background layer already
     fills 100% of whatever shape the launcher crops it into (circle/squircle/rounded-
     square, varies by launcher - Ubuntu Touch has no equivalent masking), so the white
     glyph only needs to stay within a safe center zone rather than reaching the edges
     itself. Same original coordinates as the source SVG's accent bars/signature path,
     unscaled - they already sit comfortably inside the safe zone on their own. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="128"
    android:viewportHeight="128">
    <path
        android:pathData="M40,42 h48 a3,3 0 0 1 3,3 a3,3 0 0 1 -3,3 h-48 a3,3 0 0 1 -3,-3 a3,3 0 0 1 3,-3 z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M40,58 h36 a3,3 0 0 1 3,3 a3,3 0 0 1 -3,3 h-36 a3,3 0 0 1 -3,-3 a3,3 0 0 1 3,-3 z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M40,84 C 48,74 54,90 62,80 S 76,74 84,82"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
