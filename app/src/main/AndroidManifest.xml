<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="com.owncloud.android.providers.PERMISSION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package visibility: the SSO account picker needs to see the
         Nextcloud Files app to offer/import an account from it. -->
    <queries>
        <package android:name="com.nextcloud.client" />
    </queries>

    <application
        android:name=".NextSignApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.NextSign">
        <!-- Without this, Android destroys and recreates the whole Activity on
             rotation by default - since all app state (current screen, documents,
             signature drawing, etc.) lives in plain MainActivity fields rather than a
             ViewModel/SavedStateHandle, a recreate wiped it all, dumping the user back
             to the document list mid-task. This makes Compose just re-lay-out in
             place instead, keeping everything intact. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets a downloaded document be handed to another installed app via a
             content:// URI, the equivalent of the Ubuntu Touch app's content-hub
             export flow - a plain file:// URI can't be shared with other apps on
             modern Android. -->
        <!-- UnifiedPush proof-of-concept (Tier 2 of the push notifications plan) -
             receives real Nextcloud WebPush notifications via whichever distributor
             the user has installed (e.g. ntfy). No bridge/server of our own. -->
        <service
            android:name=".push.PushServiceImpl"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
